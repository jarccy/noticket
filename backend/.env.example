# Copia este archivo a .env y ajusta tus credenciales
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/dbnoticket?sslmode=disable
PORT=8080
# Orígenes permitidos para CORS (separados por coma). * = todos. Por defecto: FRONTEND_URL
CORS_ORIGINS=http://localhost:5173
# Correos con rol admin (separados por coma). Se aplica al arrancar y al registrarse.
# Los demás roles (boss) los asigna un admin con PATCH /api/users/{id}
ADMIN_EMAILS=
# debug | release
GIN_MODE=debug

# URL pública de este backend (Google redirige a PUBLIC_URL/api/auth/google/callback)
PUBLIC_URL=http://localhost:8080
# URL del frontend (destino tras el login con Google y base de los enlaces de restablecimiento)
FRONTEND_URL=http://localhost:5173

# Google OAuth (https://console.cloud.google.com/apis/credentials → ID de cliente OAuth "Aplicación web")
# URI de redireccionamiento autorizado: http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP para el correo de "restablecer contraseña". Si SMTP_HOST está vacío, el enlace se imprime en el log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu@gmail.com, SMTP_PASSWORD=<contraseña de aplicación>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Noticket <no-reply@example.com>
